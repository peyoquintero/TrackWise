rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public Read Access for Dataset Records (Census Tracts, Stores, Community Sites, Metrics)
    // Allows any application, Looker Studio connector, dashboard, or external client to read the database
    match /census_tracts/{geoid} {
      allow read: if true;
      allow write: if false;
    }

    match /snap_retailers/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    match /churches/{churchId} {
      allow read: if true;
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false;
    }

    match /summary_metrics/{countyId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
